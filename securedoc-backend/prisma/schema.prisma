generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVESTIGATOR
  VIEWER
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  fullName  String?
  email     String?   @unique
  role      Role      @default(VIEWER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cases      Case[]     @relation("CaseCreatedBy")
  documents  Document[] @relation("DocumentUploadedBy")
  auditLogs  AuditLog[] @relation("AuditLogUser")
}

model Case {
  id          Int       @id @default(autoincrement())
  caseNumber  String    @unique
  title       String
  description String?
  status      String    @default("OPEN")
  createdById Int
  createdBy   User      @relation("CaseCreatedBy", fields: [createdById], references: [id])
  documents   Document[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id                   Int       @id @default(autoincrement())
  title                String
  fileName             String
  mimeType             String
  fileSize             Int
  filePath             String
  originalFilePath     String
  sha256Hash           String
  blockchainTxHash     String?
  blockchainRegistered Boolean   @default(false)
  caseId               Int
  case                 Case      @relation(fields: [caseId], references: [id])
  uploadedById         Int
  uploadedBy           User      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  auditLogs            AuditLog[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  action     String
  details    String?
  ipAddress  String?
  documentId Int?
  document   Document? @relation(fields: [documentId], references: [id])
  userId     Int?
  user       User?     @relation("AuditLogUser", fields: [userId], references: [id])
  timestamp  DateTime  @default(now())
}
